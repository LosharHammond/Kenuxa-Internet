PORT=3210
HOST=127.0.0.1
NODE_ID=kenuxa-home
DATA_DIR=./data
# Choose long random secrets. ADMIN_TOKEN is different on each node.
ADMIN_TOKEN=
# All trusted peers share NETWORK_SECRET. Never use ADMIN_TOKEN here.
NETWORK_SECRET=
# Comma-separated HTTPS origins, without paths. Restart after changing.
PEER_URLS=
SYNC_INTERVAL_SECONDS=120
# Optional Groq teacher; teaches reusable research methods for unknown questions.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional teachers. Set an exact model ID available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Default crawler is enabled; source URLs, interval and auto-learning are in Web learning.
# Use false to force pause at startup (useful for tests or offline installations).
CRAWLER_ENABLED=true
# Only for local federation testing. Never enable on Render.
ALLOW_LOCAL_PEERS=false

# Unknown-question discovery: Wikipedia without a key; Brave general web search with your key.
RESEARCH_ENABLED=true
BRAVE_SEARCH_API_KEY=

# ---------- v0.4: Supabase storage (recommended for every hosted node) ----------
# Project URL from Supabase → Project Settings → API. Run supabase/migrations/0001_kenuxa_internet_v04.sql first.
SUPABASE_URL=https://jqpvsjwpxvjvptyeymze.supabase.co
# Server-side secret: the "service_role" key or a new "sb_secret_..." key. Never put it in browser code or Git.
SUPABASE_SERVICE_ROLE_KEY=
# ---------- v0.4: hosting & federation ----------
# Auto-detected on Render, Railway, Vercel, Netlify and Fly; set it for custom domains.
PUBLIC_URL=
# Lets Vercel Cron / external schedulers call /cron/tick (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
EVOLUTION_INTERVAL_SECONDS=120
# Import peers' VERIFIED/GLOBAL atoms as approved instead of pending (off by default).
FEDERATION_AUTO_APPROVE=false
MAX_ATOMS=500
# ---------- v0.4: KENUXA Core Transformer (9 layers, 81 heads) ----------
# nano ≈ 2.5M params (any CPU) · lite ≈ 9.7M · core ≈ 39M (strong machine)
TRANSFORMER_PROFILE=nano
TRANSFORMER_ENABLED=true
# Continuous background training on long-running hosts (off automatically on serverless).
TRANSFORMER_TRAINING=true
TRANSFORMER_MIN_STEPS_FOR_DRAFTS=1000
TRANSFORMER_MIN_STEPS_FOR_LINKS=2000
TRANSFORMER_SAVE_SECONDS=300
# Add identity-initialised layers on top of the base 9 (modular stacking), e.g. 3 → 12 layers.
TRANSFORMER_EXTRA_LAYERS=0

# Bundled offline dictionary and educational foundation.
FOUNDATION_ENABLED=true
# New federated record storage: no cloud writes or provisioning by default.
KNOWLEDGE_STORAGE_AUTO=false
KNOWLEDGE_STORAGE_REPLICAS=1
# Local files on ephemeral hosting do not count as durable replicas. Set true only for an actual mounted persistent disk.
KNOWLEDGE_LOCAL_DURABLE=false
# JSON array of reviewed adapter configurations; keys are supplied via keyEnv names. See docs/FOUNDATION-STORAGE.md.
KNOWLEDGE_STORAGE_PROVIDERS=[]
TURSO_AUTH_TOKEN=
