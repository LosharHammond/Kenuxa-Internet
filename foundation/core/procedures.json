  {
    "id": "proc:charge-time",
    "category": "procedure",
    "label": "Charging time: energy needed ÷ (charger power × efficiency)",
    "status": "validated",
    "confidence": 0.95,
    "provenance": {
      "source": "core library (v1.7)"
    },
    "evidence": [
      {
        "kind": "test",
        "ref": "own test cases",
        "detail": "hand-computed expected values"
      }
    ],
    "body": {
      "inputs": [
        {
          "name": "energy",
          "dim": "energy",
          "unit": "Wh",
          "cues": "battery|capacity|needed|to charge"
        },
        {
          "name": "charger",
          "dim": "power",
          "unit": "W",
          "cues": "charger|charging|adapter|input"
        },
        {
          "name": "efficiency",
          "dim": "fraction",
          "unit": "%",
          "cues": "efficiency|efficient",
          "default": 85
        }
      ],
      "steps": [
        {
          "as": "time",
          "expr": "energy / (charger * efficiency)",
          "dim": "time"
        }
      ],
      "outputs": [
        {
          "name": "time",
          "unit": "h"
        }
      ],
      "tests": [
        {
          "inputs": {
            "energy": 17,
            "charger": 20,
            "efficiency": 85
          },
          "expect": {
            "time": 1
          }
        },
        {
          "inputs": {
            "energy": 100,
            "charger": 50,
            "efficiency": 100
          },
          "expect": {
            "time": 2
          }
        }
      ],
      "goal": "charging-time"
    }
  },
  {
    "id": "proc:solar-daily-energy",
    "category": "procedure",
    "label": "Daily solar energy: panel power × peak sun hours × system efficiency",
    "status": "validated",
    "confidence": 0.95,
    "provenance": {
      "source": "core library (v1.7)"
    },
    "evidence": [
      {
        "kind": "test",
        "ref": "own test cases",
        "detail": "hand-computed expected values"
      }
    ],
    "body": {
      "inputs": [
        {
          "name": "panel",
          "dim": "power",
          "unit": "W",
          "cues": "panel|solar|array|pv"
        },
        {
          "name": "sun",
          "dim": "time",
          "unit": "h",
          "cues": "sun|peak sun|sunshine|hours of sun"
        },
        {
          "name": "efficiency",
          "dim": "fraction",
          "unit": "%",
          "cues": "efficiency|losses",
          "default": 75
        }
      ],
      "steps": [
        {
          "as": "energy",
          "expr": "panel * sun * efficiency",
          "dim": "energy"
        }
      ],
      "outputs": [
        {
          "name": "energy",
          "unit": "Wh"
        }
      ],
      "tests": [
        {
          "inputs": {
            "panel": 300,
            "sun": 5,
            "efficiency": 75
          },
          "expect": {
            "energy": 1125
          }
        },
        {
          "inputs": {
            "panel": 100,
            "sun": 4,
            "efficiency": 100
          },
          "expect": {
            "energy": 400
          }
        }
      ]
    }
  },
  {
    "id": "proc:panels-needed",
    "category": "procedure",
    "label": "Panels needed: daily energy ÷ energy one panel gives per day (rounded up)",
    "status": "validated",
    "confidence": 0.95,
    "provenance": {
      "source": "core library (v1.7)"
    },
    "evidence": [
      {
        "kind": "test",
        "ref": "own test cases",
        "detail": "hand-computed expected values"
      }
    ],
    "body": {
      "inputs": [
        {
          "name": "need",
          "dim": "energy",
          "unit": "Wh",
          "cues": "need|daily|per day|use|consumption"
        },
        {
          "name": "panel",
          "dim": "power",
          "unit": "W",
          "cues": "panel|solar|pv"
        },
        {
          "name": "sun",
          "dim": "time",
          "unit": "h",
          "cues": "sun|peak sun|sunshine"
        },
        {
          "name": "efficiency",
          "dim": "fraction",
          "unit": "%",
          "cues": "efficiency|losses",
          "default": 75
        }
      ],
      "steps": [
        {
          "as": "perPanel",
          "expr": "panel * sun * efficiency",
          "dim": "energy"
        },
        {
          "as": "panels",
          "expr": "ceil(need / perPanel)",
          "dim": "number"
        }
      ],
      "outputs": [
        {
          "name": "panels",
          "unit": ""
        }
      ],
      "tests": [
        {
          "inputs": {
            "need": 3000,
            "panel": 300,
            "sun": 5,
            "efficiency": 75
          },
          "expect": {
            "panels": 3
          }
        },
        {
          "inputs": {
            "need": 400,
            "panel": 100,
            "sun": 4,
            "efficiency": 100
          },
          "expect": {
            "panels": 1
          }
        }
      ],
      "goal": "panels"
    }
  }
]
