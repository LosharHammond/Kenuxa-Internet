[
  {
    "id": "proc:energy-consumption",
    "category": "procedure",
    "label": "Energy used by a device: power × time",
    "status": "validated",
    "confidence": 0.95,
    "provenance": {
      "source": "core library (v1.7)"
    },
    "evidence": [
      {
        "kind": "test",
        "ref": "own test cases",
        "detail": "hand-computed expected values"
      }
    ],
    "body": {
      "inputs": [
        {
          "name": "power",
          "dim": "power",
          "unit": "W",
          "cues": "rated|uses|draws|consumes|load|bulb|appliance|device|fan|tv|fridge|kettle|laptop|iron"
        },
        {
          "name": "duration",
          "dim": "time",
          "unit": "h",
          "cues": "for|runs|use|hours a day|per day|daily|on for"
        }
      ],
      "steps": [
        {
          "as": "energy",
          "expr": "power * duration",
          "dim": "energy"
        }
      ],
      "outputs": [
        {
          "name": "energy",
          "unit": "Wh"
        }
      ],
      "tests": [
        {
          "inputs": {
            "power": 60,
            "duration": 5
          },
          "expect": {
            "energy": 300
          }
        },
        {
          "inputs": {
            "power": {
              "value": 1.5,
              "unit": "kW"
            },
            "duration": {
              "value": 90,
              "unit": "min"
            }
          },
          "expect": {
            "energy": 2250
          }
        }
      ]
    }
  },
