  {
    "id": "proc:runtime",
    "category": "procedure",
    "label": "How long stored energy lasts: energy ÷ power drawn",
    "status": "validated",
    "confidence": 0.95,
    "provenance": {
      "source": "core library (v1.7)"
    },
    "evidence": [
      {
        "kind": "test",
        "ref": "own test cases",
        "detail": "hand-computed expected values"
      }
    ],
    "body": {
      "inputs": [
        {
          "name": "energy",
          "dim": "energy",
          "unit": "Wh",
          "cues": "battery|stored|capacity|remaining|left"
        },
        {
          "name": "load",
          "dim": "power",
          "unit": "W",
          "cues": "uses|draws|consumes|load|running|use"
