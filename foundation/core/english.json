  "RULES": {
    "subject-verb-agreement": "A finite verb agrees with its subject in person and number.",
    "copula-complement": "A copular verb links a subject to a predicate adjective, noun phrase or prepositional phrase.",
    "progressive-aspect": "be + present participle (-ing) expresses an ongoing event.",
    "perfect-aspect": "have + past participle expresses a completed event relevant to a reference time.",
    "passive-voice": "be + past participle promotes the patient to subject.",
    "do-support": "do appears in questions and negation when no other auxiliary is present.",
    "subject-aux-inversion": "In yes/no questions the first auxiliary precedes the subject.",
    "modal-base": "A modal verb is followed by a verb in base form.",
    "determiner-noun": "A determiner precedes and specifies a noun phrase head.",
    "verb-phrase-ellipsis": "An auxiliary without its verb phrase (“Are you?”, “So am I.”, “I can’t.”) recovers the missing predicate from the preceding discourse.",
    "additive-inversion": "“so/neither + auxiliary + subject” adds a new subject to the previous predicate (positive with so, negative with neither/nor).",
    "idiomatic-composition": "An idiom’s meaning is not the composition of its words; the literal reading stays available as an alternative.",
    "classification-entailment": "If X is a kind of Y and Y is a kind of Z, then X is a kind of Z (IS_A is transitive).",
    "causal-transitivity": "If A causes B and B causes C, A is a possible (indirect) cause of C — a defeasible inference, weaker than each direct link.",
    "transformation-roles": "With verbs of transformation (convert, transform, turn) the “into” phrase names the output and the direct object the input."
  },
