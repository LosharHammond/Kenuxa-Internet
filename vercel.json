{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/index.mjs": { "maxDuration": 60, "includeFiles": "{public,lib,network,foundation}/**" } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/cron/tick", "schedule": "17 3 * * *" }]
}
